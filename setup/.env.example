# Copy this file to .env and adjust if needed, then `source .env` before running fork.sh.
# All variables are optional — fork.sh falls back to the defaults below.

# L2 JSON-RPC endpoint to fork from: the official public RPC. A submission must use it (leave it as
# is): prepare-submission.sh / verify-submission.sh refuse any other value unless --allow-test-fork,
# and such a package is not valid. The URL is printed in the (unmasked) log.
L2_RPC_URL=https://zkevm-rpc.com/

# Local port the Anvil shadow-fork listens on.
ANVIL_PORT=8545

# Anvil block time, in seconds (batch-mines pending txs into one block every N seconds
# instead of one block per tx).
BLOCK_TIME=2

# Foundry Docker image Anvil runs from (pinned for reproducibility; fork.sh needs Docker).
# ANVIL_IMAGE=ghcr.io/foundry-rs/foundry:v1.5.1

# File the full output of fork.sh (and Anvil) is saved to, besides being shown on screen.
# Overwritten on every start; submit it with your case. Default: setup/fork.log.
# FORK_LOG=./fork.log

# FOR TESTING ONLY: block to fork at (default: the zkEVM halt block, 33391890). It must still
# equal the latest block of L2_RPC_URL, so use it with a test node. fork.sh prints a warning
# (kept in fork.log) when this is set, and such a fork is not valid for a real submission.
# FORK_BLOCK=
