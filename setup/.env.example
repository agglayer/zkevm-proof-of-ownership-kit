# Copy this file to .env and adjust if needed, then `source .env` before running fork.sh.
# All variables are optional — fork.sh falls back to the defaults below.

# L2 JSON-RPC endpoint to fork from.
L2_RPC_URL=https://zkevm-rpc.com/

# Local port the Anvil shadow-fork listens on.
ANVIL_PORT=8545

# Anvil block time, in seconds (batch-mines pending txs into one block every N seconds
# instead of one block per tx).
BLOCK_TIME=2
